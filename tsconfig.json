{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",

    "module": "Preserve",
    "moduleDetection": "force",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,

    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,

    "types": ["bun"],
  },

  "include": ["**/*.ts"],
  "exclude": ["**/pi/extensions/*"],
}
